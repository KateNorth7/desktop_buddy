# Runtime only. Copy to .env for local development. Never commit credentials.
# These variables apply to the "Use my API keys" connection. Built-in AI routes
# through the Supabase gateway and ignores them.
# Full Claude Messages API endpoint, not a base URL.
ANTHROPIC_API_URL=https://api.anthropic.com/v1/messages
ANTHROPIC_API_KEY=
# Primary Claude model for background reasoning, matching and auxiliary operations.
ANTHROPIC_MODEL_ID=claude-opus-5-5
# Optional separate model for interactive dialogue and natural replies.
# ANTHROPIC_RESPONSE_MODEL_ID=
# Optional separate model for screen understanding; Claude models accept images.
# ANTHROPIC_VISION_MODEL_ID=
# Simulated activity; AI calls are still real unless AI_MOCK is explicitly true.
DEMO_MODE=false
AI_MOCK=false
# Optional public HTTPS contact-service endpoint. No server secrets belong in this file.
CONTACT_API_URL=
